generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Raffle {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float
  drawDate    DateTime?
  images      String[] // URLs of images
  totalTickets Int      @default(100)
  status      String   @default("ACTIVE") // ACTIVE, DRAWN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tickets     Ticket[]
  winnerTicketId Int?  // ID del ticket ganador (Lotería Nacional)
}

model Ticket {
  id          Int      @id @default(autoincrement())
  number      Int
  status      String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  
  raffleId    Int
  raffle      Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  
  purchaseId  Int?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([raffleId, number])
}

model Purchase {
  id             Int      @id @default(autoincrement())
  customerName   String
  customerPhone  String
  customerEmail  String
  totalAmount    Float
  mpPreferenceId String?
  mpPaymentId    String?
  paymentMethod  String   @default("MERCADOPAGO") // MERCADOPAGO, TRANSFERENCIA, EFECTIVO
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  tickets        Ticket[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
}
